# Backend secrets. init_env.py generates local values when these are empty.
# DATABASE_URL format: postgresql+psycopg://user:encoded_password@host:5432/database
DATABASE_URL=
JWT_SECRET_KEY=

# Optional overrides (defaults live in code): CORS_ORIGINS, VITE_API_BASE_URL,
# JWT_ISSUER, JWT_AUDIENCE, JWT_ACCESS_TTL_SECONDS, JWT_REFRESH_TTL_SECONDS.
# Frontend defaults to same-origin /api; Vite proxies it to 127.0.0.1:8000.
# On Vercel Services leave VITE_API_BASE_URL unset (or empty): /api stays on
# the deployment's own domain. Do not put internal service-binding URLs in VITE_*.
# DATABASE_URL must point to hosted PostgreSQL, not localhost on Vercel.
# Supabase transaction pooling: copy the pooler URL (port 6543), use
# postgresql+psycopg and append ?sslmode=require. See docs/vercel.md.
# For a Quick Tunnel, put its exact hostname in .env.local, then restart Vite:
# TUNNEL_HOSTNAME=your-current-host.trycloudflare.com

# Optional VNPAY sandbox. Secrets stay on the backend; never prefix them VITE_.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_RETURN_URL=http://localhost:5173/payment/vnpay-return
# When testing through a tunnel, replace localhost with its public HTTPS origin.
# Register a public HTTPS /api/payments/vnpay/ipn URL in the VNPAY merchant portal.
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# Optional known server IP for QueryDR; never use a customer's IP here.
# Blank uses the ASGI server/listener address (loopback fallback), not public NAT discovery.
VNPAY_QUERY_IP=

# Supabase public frontend configuration.
# These are public API settings, not SQLAlchemy database credentials.
# For backend PostgreSQL, copy DATABASE_URL from Supabase Connect.
# .env.local overrides .env for frontend/backend; process variables override both.
VITE_SUPABASE_URL=https://lymwqsbqylrqukfuoqoq.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_WV-mc3KQxokDXBJQl-HAnA_LjYnhRn0
