# Backend secrets. init_env.py generates local values when these are empty.
# DATABASE_URL format: postgresql+psycopg://user:encoded_password@host:5432/database
DATABASE_URL=
JWT_SECRET_KEY=

# Optional overrides (defaults live in code): CORS_ORIGINS, VITE_API_BASE_URL,
# JWT_ISSUER, JWT_AUDIENCE, JWT_ACCESS_TTL_SECONDS, JWT_REFRESH_TTL_SECONDS.
# Frontend defaults to same-origin /api; Vite proxies it to 127.0.0.1:8000.
# For a Quick Tunnel, put its exact hostname in .env.local, then restart Vite:
# TUNNEL_HOSTNAME=your-current-host.trycloudflare.com

# Optional VNPAY sandbox. Secrets stay on the backend; never prefix them VITE_.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_RETURN_URL=http://localhost:5173/payment/vnpay-return
# When testing through a tunnel, replace localhost with its public HTTPS origin.
# Register a public HTTPS /api/payments/vnpay/ipn URL in the VNPAY merchant portal.
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
